.macro TW_EXIT code
    mov rax, TW_SYS_EXIT
    mov rdi, \code
    int 0x80
.endm

.macro TW_WRITE handle, label, length
    mov rax, TW_SYS_WRITE
    mov rdi, \handle
    lea rsi, [rip + \label]
    mov edx, OFFSET \length
    int 0x80
.endm
